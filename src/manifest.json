{
  "name": "__MSG_extName__",
  "version": "3.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "homepage_url": "https://github.com/ErnaneJ/tradingworks-plus",
  "icons": {
    "16": "assets/icons/favicon16.png",
    "32": "assets/icons/favicon32.png",
    "48": "assets/icons/favicon48.png",
    "128": "assets/icons/favicon128.png"
  },
  "permissions": ["storage", "notifications", "offscreen", "alarms"],
  "host_permissions": ["https://app.tradingworks.net/*"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "assets/icons/favicon16.png",
      "32": "assets/icons/favicon32.png",
      "48": "assets/icons/favicon48.png",
      "128": "assets/icons/favicon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}
